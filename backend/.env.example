PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/smart_disaster_management?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_disaster_management

# For a local MongoDB instance, use this URI instead:
# MONGODB_URI=mongodb://127.0.0.1:27017/smart_disaster_management

# Optional: use when the system DNS cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
